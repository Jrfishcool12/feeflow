# --- Solana ---
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# The routing key. It is set as the creator of every coin launched here and is the
# admin of each coin's fee sharing. The code only ever points fees at donate.gg charity
# escrows plus the fixed platform cut, and every change is public on-chain.
# Base58 secret or JSON byte array. Keep ~1 SOL in it for setup and crank fees.
AUTHORITY_SECRET_KEY=
# Split of every coin's creator fees, in basis points. Charity gets the rest (90% by default).
# donate.gg also takes its own fee out of the charity share.
PLATFORM_WALLET=
PLATFORM_BPS=500
# Buys the platform coin and burns it (hourly, from a buyback wallet derived from the authority key)
BUYBACK_BPS=500
# Each buyback fires at a random time in this window (seconds), drawn fresh every time
BUYBACK_MIN_SECONDS=300
BUYBACK_MAX_SECONDS=3600
# The platform's own Pump.fun coin. Defaults to HOUSE_MINT.
PLATFORM_COIN_MINT=
# How often an honoree can switch charities after their first pick
CHANGE_COOLDOWN_DAYS=30

# --- Relay mode (coins launched elsewhere). Leave both empty to turn it off. ---
# Derives every relay vault key. Back it up with the database; losing either strands vault funds.
MASTER_SEED=
# Mint of a coin launched through this site (e.g. the platform's own coin). Relay donations
# go through its donation escrows, because only a coin's admin can create escrows for it.
HOUSE_MINT=
# Nonprofit (donate.gg config id) that relayed coins start with when their description names none.
DEFAULT_CONFIG_ID=

# --- Coin metadata upload (optional). Without it, deployers paste a metadata URI. ---
PINATA_JWT=

# --- X ---
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BOT_APP_KEY=
X_BOT_APP_SECRET=
X_BOT_ACCESS_TOKEN=
X_BOT_ACCESS_SECRET=
BRAND_HANDLE=goodcall

# --- App ---
PUBLIC_URL=http://localhost:8787
PORT=8787
DB_PATH=./goodcall.db
SESSION_SECRET=change-me-32-plus-chars-long-random-string
CRANK_SECONDS=600

# Donations are held until the honoree chooses a nonprofit. After this many days without a choice,
# they go to the coin's fallback nonprofit. 0 = hold until they choose, with no time limit.
HOLD_DAYS=90
